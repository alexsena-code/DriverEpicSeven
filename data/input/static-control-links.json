    "hypotheses_supported_by_structure": [
      "Four individually selectable formation positions exist.",
      "Selected-member controls distinguish removing from viewing details.",
      "Four change buttons suggest explicit position choice; dragging is not established by the layout."
    ],
    "scoped_live_workflows": {
      "reference": "docs/validation.md#otherworld-e-formacao",
      "position_swap": [
        "select existing member",
        "observe selected controls and other change targets",
        "select another occupied slot",
        "verify identities at both positions"
      ],
      "replacement": [
        "select the roster instance",
        "activate its observed plus control",
        "observe slot choices",
        "choose the occupied target slot",
        "verify new composition and displaced member absence"
      ],
      "removal": {
        "status": "scoped_manual_roundtrip_validated",
        "reference": "docs/validation.md#mapeamento-reversivel",
        "candidate_path": "/Layer/new/formation/selected_btn/btn_remove",
        "steps": [
          "select existing member and observe remove/details controls",
          "activate remove once and verify empty slot",
          "select the same recently observed roster card and activate plus",
          "choose the empty purple plus instead of occupied swap arrows",
          "verify hero identity, positions and restored composition"
        ],
        "identity_limit": "Visual name/level/card continuity only; no internal owned-instance identifier exposed.",
        "runtime_enabled": false
      }
    },
